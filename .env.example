# Copy to .env and fill in. Both values come from:
#   Supabase Dashboard -> Project Settings -> API Keys
#
# The anon / publishable key is safe to expose in the browser - Row Level
# Security is what protects the data. NEVER put the service_role key here;
# VITE_ variables are bundled into the client JavaScript.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Only needed to run the two tests that sign in as real admins:
#
#   node --env-file=.env scripts/test-presence.mjs
#   node --env-file=.env scripts/test-cycle-count-live.mjs
#
# They must be TWO DIFFERENT accounts - both tests check that one admin is
# correctly blocked by the other. The app itself never reads these, and the
# build never sees them: they have no VITE_ prefix, so Vite leaves them out of
# the bundle. .env is gitignored, so they stay on this machine.
#
# Leave them out entirely if you are not running those two tests.
# ---------------------------------------------------------------------------

ADMIN_A_EMAIL=first-admin@example.com
ADMIN_A_PASSWORD=
ADMIN_B_EMAIL=second-admin@example.com
ADMIN_B_PASSWORD=
