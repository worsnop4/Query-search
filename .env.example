# Copy to .env and fill in. Both values come from:
#   Supabase Dashboard -> Project Settings -> API Keys
#
# The anon / publishable key is safe to expose in the browser - Row Level
# Security is what protects the data. NEVER put the service_role key here;
# VITE_ variables are bundled into the client JavaScript.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
